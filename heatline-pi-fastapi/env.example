# ==============================
# Heatline Pi FastAPI - RTSP Proxy Example
# Raspberry Pi 5 receives RTSP from IP camera and re-serves as /stream.mjpg
# ==============================

# --- FastAPI service ---
PI_API_HOST=0.0.0.0
PI_API_PORT=9000
PI_API_RELOAD=false

# --- Device identity ---
DEVICE_ID=101
DEVICE_SERIAL=KW-PI5-101
DEVICE_NAME=영동고속도로 1호 구간
CUSTOMER_ID=1
INSTALL_ADDRESS=강원도 영동군 영동로 101
INSTALL_LOCATION=터널 입구
LATITUDE=37.123456
LONGITUDE=128.123456
ALLOW_CUSTOMER_CONTROL=true

# --- Authentication / tokens ---
INTERNAL_TOKEN=change-this-internal-token
DEVICE_SHARED_TOKEN=change-this-device-token
REQUEST_TIMEOUT_MS=5000

# --- Public endpoint exposed to frontend / backend ---
# Set this to the Raspberry Pi reachable origin.
# Example internal network: http://192.168.75.50:9000
PUBLIC_BASE_URL=http://192.168.75.50:9000
PI_PUBLIC_HOST=192.168.75.50
STREAM_PATH=/stream.mjpg
STREAM_HOST=0.0.0.0
STREAM_PORT=8000

# --- Camera source mode ---
# Use rtsp for external IP camera proxying
CAMERA_SOURCE=rtsp
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=10
CAMERA_ROTATION=0
CAMERA_HFLIP=false
CAMERA_VFLIP=false
CAMERA_JPEG_QUALITY=80
CAMERA_TEXT_OVERLAY=true
CAMERA_CONNECT_TIMEOUT_SEC=8
CAMERA_RECONNECT_INTERVAL_SEC=3.0
CAMERA_FAILURE_LIMIT=20
PLACEHOLDER_STREAM=true
CAMERA_USE_PICAMERA2=false
CAMERA_DEVICE_INDEX=0

# --- External IP camera RTSP ---
CAMERA_RTSP_URL=rtsp://192.168.75.60:554/stream1
# If your IP camera requires RTSP authentication, fill these in.
CAMERA_RTSP_USERNAME=
CAMERA_RTSP_PASSWORD=
# Recommended for stability on Raspberry Pi network environments
CAMERA_RTSP_TRANSPORT=tcp

# --- Sensor defaults ---
SENSOR_SIMULATION=true
TEMPERATURE_DEFAULT=-2.5
HUMIDITY_DEFAULT=68.0
SNOW_THRESHOLD=0.80
HEATER_MODE=auto

# --- Central backend sync ---
# Example:
# CENTRAL_API_BASE=https://your-backend.example.com/api/v1
CENTRAL_API_BASE=
CENTRAL_DEVICE_TOKEN=
DEVICE_SYNC_TOKEN=
PAIRING_ENABLED=true
PROVISION_KEY=
CENTRAL_CONTROLLER_ID=0
SYNC_INTERVAL_SEC=15

# --- Firmware / model info ---
FIRMWARE_VERSION=
HARDWARE_MODEL=Raspberry Pi 5 + RTSP Proxy

# --- Runtime policy ---
SCHEDULE_POLL_INTERVAL_SEC=15
OFFLINE_FALLBACK_ENABLED=true
OFFLINE_GRACE_SEC=90

# --- AI / Hailo (optional, keep disabled if not using yet) ---
HAILO_ENABLED=false
HAILO_MODEL_PATH=
HAILO_MODEL_NAME=snow-scene-classifier
HAILO_LABELS=clear,snowing
HAILO_INPUT_WIDTH=224
HAILO_INPUT_HEIGHT=224
AI_LOOP_INTERVAL_SEC=2.0
AI_WINDOW_SIZE=5
AI_REQUIRED_POSITIVE_COUNT=3
AI_SNOW_ON_THRESHOLD=0.75
AI_SNOW_OFF_THRESHOLD=0.35
AI_AUTO_CONTROL_ENABLED=false
AI_ROI_TOP_RATIO=0.05
AI_ROI_BOTTOM_RATIO=0.65
AI_ROI_LEFT_RATIO=0.10
AI_ROI_RIGHT_RATIO=0.90
AI_DEBUG_LOG=true

# --- Local storage ---
DATA_DIR=./data
SQLITE_PATH=./data/pi_device.db
